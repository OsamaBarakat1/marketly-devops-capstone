# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Nothing secret belongs in this file, or in terraform.tfvars. The RDS
# password is generated by AWS and kept in Secrets Manager, the cluster join
# token is generated on the control plane and kept in SSM, and AWS
# credentials come from the ambient credential chain. If a value here ever
# looks like a password, something has gone wrong.

# The only variable with no default: which repository may assume the CI role.
github_repo = "OsamaBarakat1/marketly-devops-capstone"

aws_region   = "us-east-1"
project_name = "marketly"
environment  = "dev"

# --- network ---
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
az_count             = 2

# --- compute ---
# t3.micro is the free-tier eligible size. The 750 free hours per month
# cover roughly one instance running continuously, and this stack runs four
# (NAT, control plane, two workers), so tear it down between sessions.
nat_instance_type        = "t3.micro"
k3s_server_instance_type = "t3.micro"
k3s_agent_instance_type  = "t3.micro"

worker_min_size         = 2
worker_max_size         = 3
worker_desired_capacity = 2

# --- database ---
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "marketly"
db_username          = "marketly_admin"
db_multi_az          = false
