#!/usr/bin/env bash
# Blocks commits that introduce secrets. Requires gitleaks
# (https://github.com/gitleaks/gitleaks) on PATH.
#
# Activate once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH — skipping secret scan." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks) to enable this check." >&2
  exit 0
fi

gitleaks protect --staged --redact --verbose
