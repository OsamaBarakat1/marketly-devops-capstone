# Serves the Vite production build and proxies /api/* to the three backend
# services, mirroring the dev-time Vite proxy (see vite.config.js) and the
# path-based routing the Kubernetes Ingress does in front of the real
# deployment (see k8s/ingress.yaml). Host/port are env-substituted at
# container start (see Dockerfile ENV defaults) so the same image works
# against docker-compose service names without a rebuild.

# Nginx resolves a hostname written directly into proxy_pass exactly once,
# when the config loads, and then caches that address for the life of the
# process. Container addresses are not stable — recreating a backend gives it
# a new one — so without this the proxy keeps dialling an address that has
# moved, or worse, one that another service has since been given. Naming a
# resolver and passing the upstream through a variable forces nginx to look
# the name up again as it goes, honouring the TTL below.
resolver ${DNS_RESOLVER} valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # proxy_pass with a variable does not inherit the request URI the way a
    # literal one does, so $request_uri is appended explicitly on each.
    location /api/auth {
        set $auth_upstream "http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}";
        proxy_pass $auth_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/products {
        set $catalog_upstream "http://${CATALOG_SERVICE_HOST}:${CATALOG_SERVICE_PORT}";
        proxy_pass $catalog_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/categories {
        set $categories_upstream "http://${CATALOG_SERVICE_HOST}:${CATALOG_SERVICE_PORT}";
        proxy_pass $categories_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/orders {
        set $orders_upstream "http://${ORDERS_SERVICE_HOST}:${ORDERS_SERVICE_PORT}";
        proxy_pass $orders_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: let React Router handle unknown paths client-side.
    location / {
        try_files $uri /index.html;
    }
}
