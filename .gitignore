# --- secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*credentials*
*.tfvars
!*.tfvars.example
.aws/
kubeconfig
kubeconfig.*
*.kubeconfig
id_rsa
id_rsa.*
*.pub

# --- terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- local databases (each service self-seeds on boot) ---
services/*/*.db
services/*/*.sqlite3

# --- python ---
**/__pycache__/
*.pyc
*.pyo
venv/
services/*/venv/
.pytest_cache/

# --- node / frontend ---
frontend/node_modules/
frontend/dist/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store

# --- misc local artifacts ---
*.log
.env.local
