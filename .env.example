# Copy to .env to override any local development default in
# docker-compose.yml. The .env file is gitignored — never commit real
# credentials, and never reuse these values outside local development.
#
#   cp .env.example .env

# Must be identical across auth, catalog, and orders: auth signs access
# tokens with it and the other two verify them locally, with no callback.
SHARED_SECRET=dev-shared-secret-change-me

# Local PostgreSQL container credentials.
POSTGRES_USER=marketly
POSTGRES_PASSWORD=marketly_dev_password
POSTGRES_DB=marketly

# Change if 5432 is already taken on your host.
POSTGRES_PORT=5432

# The single origin allowed to send credentialed requests to auth-service.
CORS_ALLOWED_ORIGIN=http://localhost:5173
